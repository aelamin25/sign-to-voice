# ── Mode ────────────────────────────────────────────────────────────────
# true  = whole app runs on scripted mock adapters. No keys, no server, no camera needed.
# false = real adapters (needs the server below and the keys).
VITE_MOCK=true

# Optional per-service overrides when VITE_MOCK=false (set any to true to keep that one mocked):
# VITE_MOCK_RECOGNITION=false
# VITE_MOCK_TRANSLATE=false
# VITE_MOCK_TTS=false
# VITE_MOCK_STT=false
# VITE_MOCK_AVATAR=false
# VITE_MOCK_SIGNVIDEO=false

# ── Trained models (model/backend, Python, port 8000) ───────────────────
# Set this to use our models: sentences from model/lang (with the doctor's last line as context).
# VITE_PY_BACKEND=http://localhost:8000
# python = signs come from model/vision/live.py (it owns the camera) instead of the browser recogniser.
#   Run:  python model/vision/live.py --send http://localhost:8000/phrase
# VITE_RECOGNITION=python

# ── Server (never exposed to the browser) ───────────────────────────────
PORT=8787

# Claude: sign glosses -> sentence, plain-words rewrite, visit summary
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ElevenLabs: TTS (patient voice) + Scribe v2 realtime (doctor transcription)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Anam: "Maya" avatar. llmId is fixed to CUSTOMER_CLIENT_V1 so Maya only says our text.
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=

# Sign video: optional external generator. If unset, the server serves clips from
# server/sign-clips/<WORD>.mp4 and the player falls back to the animated signer.
SIGN_VIDEO_API_URL=

# ── ElevenLabs Agent + Anam face (the original prototype server: npm run agent-server, port 3001) ──
# Empty -> practice mode. ELEVENLABS_AGENT_ID -> voice mode. Agent ID + ELEVENLABS_API_KEY + ANAM_API_KEY + ANAM_AVATAR_ID -> face mode.
ELEVENLABS_AGENT_ID=

# ── Python backend (model/backend/server.py, port 8000) also reads ──────
# ANTHROPIC_API_KEY, ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID (above), plus:
# ADAPTION_API_KEY=
# LLM_PROVIDER=adaption
# ELEVENLABS_STT_MODEL=scribe_v1
