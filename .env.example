# ── Mode ────────────────────────────────────────────────────────────────
# true  = whole app runs on scripted mock adapters. No keys, no server, no camera needed.
# false = real adapters (needs the server below and the keys).
VITE_MOCK=true

# Optional per-service overrides when VITE_MOCK=false (set any to true to keep that one mocked):
# VITE_MOCK_RECOGNITION=false
# VITE_MOCK_TRANSLATE=false
# VITE_MOCK_TTS=false
# VITE_MOCK_STT=false
# VITE_MOCK_AVATAR=false
# VITE_MOCK_SIGNVIDEO=false

# ── Trained models (model/backend, Python, port 8000) ───────────────────
# Set this to use our models: sentences from model/lang (with the doctor's last line as context).
# VITE_PY_BACKEND=http://localhost:8000
# python = signs come from model/vision/live.py (it owns the camera) instead of the browser recogniser.
#   Run:  python model/vision/live.py --send http://localhost:8000/phrase
# VITE_RECOGNITION=python
# true = a finished turn from live.py starts the patient's turn by itself (no "Start signing" press needed).
# VITE_AUTO_SIGN=true
# With a live Anam avatar: it also performs the doctor's reply for the patient, silently, with a matching face.
# VITE_AVATAR_REPLY=true
# Show live.py's camera view (with hand tracking) inside the patient panel:
#   python model/vision/live.py --send http://localhost:8000/phrase --stream 8001 --no-window
# VITE_CAMERA_STREAM=http://localhost:8001/video

# ── Server (never exposed to the browser) ───────────────────────────────
PORT=8787

# Claude: sign glosses -> sentence, plain-words rewrite, visit summary
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ElevenLabs: TTS (patient voice) + Scribe v2 realtime (doctor transcription)
ELEVENLABS_API_KEY=
# The patient's voice. Paste the Voice ID from elevenlabs.io (Voices → the voice → "ID").
# Leave it EMPTY to keep the browser demo voice (en-GB, rate 0.98), the same voice as the mockup.
# Library voices must be added to "My Voices" first. Closest match to the browser demo voice:
#   Juliet (neutral British, calm virtual assistant)  QJksobp1edMNvmwcG5lm
#   Alex (neutral British female)                      zhoqoRb56kaT8dDbwmNV
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 = lowest latency (default). eleven_multilingual_v2 = highest quality, slower.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Optional voice tuning (leave empty for the voice's own settings). Speed 0.98 matches the demo pace.
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY=0.75
# ELEVENLABS_SPEED=0.98

# Anam: "Maya" avatar. With the two ElevenLabs lines above set, Maya speaks in that ElevenLabs
# voice (Anam audio passthrough, lip-synced). ANAM_VOICE_SOURCE=anam uses Anam's own voice instead
# (then ANAM_VOICE_ID is required).
ANAM_API_KEY=
ANAM_AVATAR_ID=
# ANAM_VOICE_SOURCE=anam
ANAM_VOICE_ID=
# Mood cues (the avatar's face matching the patient's expression / the doctor's tone) need a Cara 4 avatar:
# ANAM_AVATAR_MODEL=cara-4

# Sign video: optional external generator. If unset, the server serves clips from
# server/sign-clips/<WORD>.mp4 and the player falls back to the animated signer.
SIGN_VIDEO_API_URL=

# ── ElevenLabs Agent + Anam face (the original prototype server: npm run agent-server, port 3001) ──
# Empty -> practice mode. ELEVENLABS_AGENT_ID -> voice mode. Agent ID + ELEVENLABS_API_KEY + ANAM_API_KEY + ANAM_AVATAR_ID -> face mode.
ELEVENLABS_AGENT_ID=

# ── Python backend (model/backend/server.py, port 8000) also reads ──────
# ANTHROPIC_API_KEY, ELEVENLABS_API_KEY, ELEVENLABS_VOICE_ID (above), plus:
# ADAPTION_API_KEY=
# LLM_PROVIDER=adaption
# ADAPTION_CHAT_MODEL=gemma-4-31b-it   # optional; this one answered in about 0.3 s. Left unset, a known-good model is picked.
# TRANSLATE_BACKEND=stack        # sentences from a self-improving Adaption stack (see README)
# ADAPTION_STACK=                 # the stack's slug, e.g. deepseek-v4-flash-1
# USAGE_LOG=1                     # save each turn as a training example (off by default: nothing is stored)
# ELEVENLABS_STT_MODEL=scribe_v1
