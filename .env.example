# Copy this file to ".env" and fill in the values. Never commit ".env".
#
# Empty file                      -> practice mode (stand-in voice, no accounts needed)
# ELEVENLABS_AGENT_ID             -> voice mode: the ElevenLabs agent speaks
# all four values                 -> face mode: the agent speaks through an Anam avatar

# From Akshya: the agent's ID (starts with "agent_").
ELEVENLABS_AGENT_ID=

# The ElevenLabs API key. Needed if the agent is private, and always needed for face mode.
ELEVENLABS_API_KEY=

# From Akshya: the Anam API key and the ID of the chosen face.
# To switch the face off again, clear these two lines and restart.
ANAM_API_KEY=
ANAM_AVATAR_ID=
