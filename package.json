{
  "name": "sign-to-voice-clinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hackathon prototype: a Deaf patient signs, approves the sentence, and a voice speaks it to the doctor.",
  "scripts": {
    "dev": "concurrently -n server,page -c blue,green \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
