  },
  "dependencies": {
    "@anam-ai/js-sdk": "^4.29.2",
    "@elevenlabs/client": "latest",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "vite": "^6.0.0"
  }
}
