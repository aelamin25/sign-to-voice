{
  "name": "sign-to-voice-clinic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SignBridge: a Deaf patient signs, a voice speaks it to the doctor; the doctor's reply comes back in plain words and sign. Imperial AI Hack 2026.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c teal,red \"vite\" \"tsx watch server/index.ts\"",
    "dev:mock": "cross-env VITE_MOCK=true vite",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit -p . && vite build",
    "build:mock": "tsc --noEmit -p . && cross-env VITE_MOCK=true vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server",
    "start": "tsx server/index.ts",
    "agent-server": "node server/index.js",
    "legacy:web": "vite legacy/web"
  },
  "dependencies": {
    "@anam-ai/js-sdk": "^4.29.2",
    "@elevenlabs/client": "^1.36.1",
    "@mediapipe/tasks-vision": "^1.2.3",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
